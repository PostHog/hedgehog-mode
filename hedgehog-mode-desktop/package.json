{
  "name": "hedgehog-mode-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop hedgehog that roams around Windows and macOS.",
  "author": "PostHog",
  "repository": "https://github.com/PostHog/hedgehog-mode",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "test": "node --test",
    "package:windows": "pnpm build && electron-builder --win nsis",
    "package:macos": "pnpm build && electron-builder --mac dmg --universal"
  },
  "dependencies": {
    "@posthog/hedgehog-mode": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.posthog.hedgehog-mode",
    "productName": "Hedgehog Mode",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../hedgehog-mode/assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Hedgehog Mode reads visible window positions so hedgehogs can walk on top of them."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
